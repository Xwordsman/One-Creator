# Local development works without PostgreSQL; data is stored in .data/local.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data/local
# DATABASE_URL=postgresql://one_creator:password@localhost:5432/one_creator
# A 64-character hex key. Locally an encryption.key file is created in DATA_DIR.
# ENCRYPTION_KEY=
COOKIE_SECURE=false
WORKER_MODE=inline
# Feeds, web import and webhooks only reach public addresses. List self-hosted services here (comma separated origins).
# INTEGRATION_ALLOWED_ORIGINS=http://rss.lan:8080

# Optional media service (npm run media): FFmpeg video synthesis and clipping.
# MEDIA_SERVICE_TOKEN=at-least-20-characters
# MEDIA_PORT=4100
# FFMPEG_PATH= / FFPROBE_PATH= default to the bundled ffmpeg-static binaries in development.

# Optional execution node (npm run executor), usually on your own computer.
# EXECUTOR_SERVER=http://127.0.0.1:3001
# EXECUTOR_TOKEN=ocn_... shown once when the node is registered in 成员与集成 · 执行节点
# EXECUTOR_DATA_DIR=.data/executor
# BROWSER_HEADLESS=false shows the browser window on this machine.
